<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LinguaPilot" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/lp_primary</item>
        <item name="colorPrimaryDark">@color/lp_primary_dark</item>
        <item name="colorAccent">@color/lp_accent</item>
        <item name="android:statusBarColor">@color/lp_primary</item>
        <item name="android:navigationBarColor">@color/lp_background</item>
        <item name="android:windowBackground">@color/lp_background</item>
    </style>

    <style name="Theme.LinguaPilot.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lp_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LinguaPilot</item>
    </style>
</resources>
